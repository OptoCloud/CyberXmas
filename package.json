{
  "name": "cyber-incident-christmas-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/cloudflare-entry.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:smoke": "node scripts/worker-smoke.ts",
    "test:e2e": "node scripts/worker-e2e.ts",
    "preview": "pnpm run build && wrangler dev --local --ip 127.0.0.1",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "pnpm run build && pnpm run db:remote && wrangler deploy",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:preview": "node scripts/deploy-preview.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "9.0.0",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "^6.0.3",
    "vite": "8.3.8",
    "wrangler": "4.165.0"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0"
  }
}
